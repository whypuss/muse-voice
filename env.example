# Upstream sandbox / corporate egress proxy (if required)
https_proxy=http://username:password@egress-proxy.example.com:8080
HTTPS_PROXY=http://username:password@egress-proxy.example.com:8080
http_proxy=http://username:password@egress-proxy.example.com:8080
HTTP_PROXY=http://username:password@egress-proxy.example.com:8080

# Optional: Override Gemini API Key directly in env
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: Override target node (host:port)
# FORWARDER_TARGET=YOUR_NODE_HOST:YOUR_NODE_PORT
